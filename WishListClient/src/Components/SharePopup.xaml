<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="WishListClient.src.Components.SharePopup"
    BackgroundColor="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <Border 
        StrokeShape="RoundRectangle 16"
        BackgroundColor="#1E1E1E" 
        Padding="20"
        StrokeThickness="0"
        Stroke="Transparent"
        WidthRequest="300"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <VerticalStackLayout Spacing="15">
            <Label Text="Поделиться желанием" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="White"/>

            <Grid ColumnDefinitions="*, *" 
                  BackgroundColor="#2C2C2C" 
                  Padding="2" 
                  ColumnSpacing="2"
                  HeightRequest="40">

                <Button x:Name="BtnLinkTab"
                        Text="Ссылка"
                        Clicked="OnLinkTabClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource Secondary}"
                        CornerRadius="6"
                        FontSize="14"/>

                <Button x:Name="BtnQrTab"
                        Grid.Column="1"
                        Text="QR-код"
                        Clicked="OnQrTabClicked"
                        BackgroundColor="#2C2C2C"
                        TextColor="Gray"
                        CornerRadius="6"
                        FontSize="14"/>
            </Grid>

            <Entry x:Name="LinkEntry"
                   Text="{Binding ShareLink, Mode=OneWay}"
                   IsReadOnly="True"
                   BackgroundColor="#2C2C2C"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   Margin="0, 5"
                   IsVisible="True"/>

            <Image x:Name="QrImage"
                   Source="{Binding QrCodeImageSource}"
                   HeightRequest="200"
                   WidthRequest="200"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"
                   IsVisible="False"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Text="Копировать"
                        Command="{Binding CopyLinkCommand}"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="8"/>

                <Button Grid.Column="1"
                        Text="Обновить"
                        Command="{Binding GenerateNewLinkCommand}"
                        BackgroundColor="#3A3A3A"
                        TextColor="White"
                        CornerRadius="8"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>